{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pharmascope.invalid/contracts/source-snapshot.schema.json",
  "$ref": "#/$defs/SourceSnapshot",
  "$defs": {
    "SourceSnapshot": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "workspace_id": {
          "$ref": "#/$defs/Id"
        },
        "created_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "record_id": {
          "$ref": "#/$defs/Id"
        },
        "content_hash": {
          "$ref": "#/$defs/Hash"
        },
        "normalizer_version": {
          "type": "string",
          "minLength": 1
        },
        "raw_payload": {
          "type": "object",
          "properties": {},
          "required": [],
          "additionalProperties": true
        },
        "normalized": {
          "oneOf": [
            {
              "$ref": "#/$defs/TrialProjection"
            },
            {
              "$ref": "#/$defs/PublicationProjection"
            }
          ]
        },
        "source_updated": {
          "$ref": "#/$defs/DateValue"
        },
        "first_observed_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "is_demo": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "workspace_id",
        "created_at",
        "record_id",
        "content_hash",
        "normalizer_version",
        "raw_payload",
        "normalized",
        "source_updated",
        "first_observed_at",
        "is_demo"
      ],
      "additionalProperties": false
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "DateValue": {
      "type": "object",
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "precision": {
          "type": "string",
          "enum": [
            "day",
            "month",
            "year",
            "unknown"
          ]
        },
        "kind": {
          "type": "string",
          "enum": [
            "source_reported",
            "estimated",
            "actual",
            "unknown"
          ]
        }
      },
      "required": [
        "value",
        "precision",
        "kind"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "precision": {
                "const": "day"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "precision": {
                "const": "month"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "precision": {
                "const": "year"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "string",
                "pattern": "^\\d{4}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "precision": {
                "const": "unknown"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "PublicationProjection": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "authors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "journal": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "doi": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "pmid": {
          "type": "string"
        },
        "publication_date": {
          "$ref": "#/$defs/DateValue"
        },
        "abstract_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "publication_types": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "correction_relations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "relation": {
                "type": "string"
              },
              "external_id": {
                "type": "string"
              }
            },
            "required": [
              "relation",
              "external_id"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "title",
        "authors",
        "journal",
        "doi",
        "pmid",
        "publication_date",
        "abstract_text",
        "publication_types",
        "correction_relations"
      ],
      "additionalProperties": false
    },
    "TrialProjection": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "raw_status": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "NOT_YET_RECRUITING",
            "RECRUITING",
            "ENROLLING_BY_INVITATION",
            "ACTIVE_NOT_RECRUITING",
            "SUSPENDED",
            "TERMINATED",
            "COMPLETED",
            "WITHDRAWN",
            "UNKNOWN",
            "OTHER"
          ]
        },
        "phases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sponsor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "enrollment": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "count": {
                  "type": "integer",
                  "minimum": 0
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "estimated",
                    "actual",
                    "unknown"
                  ]
                }
              },
              "required": [
                "count",
                "type"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "has_results": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_updated": {
          "$ref": "#/$defs/DateValue"
        },
        "primary_outcomes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "measure": {
                "type": "string"
              },
              "description": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "time_frame": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "measure",
              "description",
              "time_frame"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "title",
        "raw_status",
        "status",
        "phases",
        "conditions",
        "sponsor",
        "enrollment",
        "has_results",
        "source_updated",
        "primary_outcomes"
      ],
      "additionalProperties": false
    },
    "Hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "Id": {
      "type": "string",
      "format": "uuid"
    }
  }
}
