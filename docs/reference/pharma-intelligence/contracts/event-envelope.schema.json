{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pharmascope.invalid/contracts/event-envelope.schema.json",
  "$ref": "#/$defs/RunEvent",
  "$defs": {
    "RunEvent": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "run_id": {
          "$ref": "#/$defs/Id"
        },
        "seq": {
          "type": "integer",
          "minimum": 1
        },
        "occurred_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "type": {
          "type": "string",
          "enum": [
            "run.queued",
            "run.started",
            "plan.updated",
            "tool.started",
            "tool.completed",
            "tool.failed",
            "evidence.added",
            "clarification.required",
            "report.ready",
            "run.partial",
            "run.completed",
            "run.failed",
            "run.cancel_requested",
            "run.cancelled",
            "run.recovery_required"
          ]
        },
        "payload": {
          "type": "object",
          "properties": {},
          "required": [],
          "additionalProperties": true
        }
      },
      "required": [
        "schema_version",
        "run_id",
        "seq",
        "occurred_at",
        "type",
        "payload"
      ],
      "additionalProperties": false
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "Id": {
      "type": "string",
      "format": "uuid"
    }
  }
}
